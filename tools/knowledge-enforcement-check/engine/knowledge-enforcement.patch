+
+
+DET = GOOD + "enforcement:\n  level: deterministic\n  solutions:\n    - {kind: lint, what: UI 文言の禁止語, issue: 318%s}\n"
+WIRED_BY = ", wired_by: [{workflow: .github/workflows/lint.yml, job: lint, runs: tools/lint/check.py}]"
+
+
+def test_solution_flags_must_be_bool_and_verified_needs_wired(tmp_path):
+    rc, out = run(tmp_path, {"K-0001.yaml": DET % ", wired: \"true\", verified: false"})
+    assert rc == 1 and "wired は true か false" in out
+    (tmp_path / "d").mkdir()
+    rc, out = run(tmp_path / "d", {"K-0001.yaml": DET % ", wired: false, verified: true"})
+    assert rc == 1 and "wired でないのに verified が true" in out
+
+
+def test_index_label_does_not_show_unwired_as_deterministic(tmp_path):
+    for flags, want in [("", "未配線"), (", wired: false, verified: false", "未配線"),
+                        (", wired: true, verified: false" + WIRED_BY, "deterministic（未確認）"),
+                        (", wired: true, verified: true" + WIRED_BY, "| deterministic |")]:
+        d = tmp_path / str(abs(hash(flags)))
+        d.mkdir()
+        rc, out = run(d, {"K-0001.yaml": DET % flags})
+        assert rc == 0, out
+        assert want in (d / kc.ROOT / "INDEX.md").read_text(encoding="utf-8")
+    assert kc.enforcement_label({"enforcement": {"level": "checklist"}}) == "checklist" and kc.enforcement_label({}) == "context"
+
+
+def test_wired_needs_wired_by_with_workflow_job_runs(tmp_path):
+    # 議決 D-0034。wired が true の解決策は配線先（.github/workflows/ の直下のファイル・job・runs）が要る。wired でなければ見ない
+    for i, (flags, want) in enumerate([
+        (", wired: true", "wired_by（配線先の workflow・job・runs の列）がない"),
+        (", wired: true, wired_by: []", "wired_by（配線先の workflow・job・runs の列）がない"),
+        (", wired: true, wired_by: {workflow: .github/workflows/lint.yml, job: lint, runs: tools/lint/check.py}", "wired_by（配線先"),
+        (", wired: true, wired_by: [{workflow: .github/workflows/lint.yml, job: lint}]", "wired_by[0] は workflow・job・runs を文字列で書く"),
+        (", wired: true, wired_by: [{workflow: .github/workflows/lint.yml, job: 1, runs: tools/lint/check.py}]", "wired_by[0] は workflow・job・runs"),
+        (", wired: true, wired_by: [.github/workflows/lint.yml]", "wired_by[0] は workflow・job・runs"),
+        (", wired: true, wired_by: [{workflow: ci/lint.yml, job: lint, runs: tools/lint/check.py}]", "wired_by[0] の workflow は .github/workflows/ の直下"),
+        (", wired: true, wired_by: [{workflow: .github/workflows/sub/lint.yml, job: lint, runs: tools/lint/check.py}]", "wired_by[0] の workflow は"),
+    ]):
+        d = tmp_path / f"bad{i}"
+        d.mkdir()
+        rc, out = run(d, {"K-0001.yaml": DET % flags})
+        assert rc == 1 and want in out, (flags, out)
+    for i, flags in enumerate([WIRED_BY.replace(", ", ", wired: true, ", 1), ", wired: false", ", wired: false, wired_by: oops", ""]):
+        d = tmp_path / f"ok{i}"
+        d.mkdir()
+        rc, out = run(d, {"K-0001.yaml": DET % flags})
+        assert rc == 0, (flags, out)
