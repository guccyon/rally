+"""製品の続きのジョブの線（continuation.yaml の conflict）の読み方（continuation_config.py）。DB は使わない"""
+import base64
+import os
+import sys
+import urllib.error
+
+import pytest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import continuation_config as cc  # noqa: E402
+
+LINE = """conflict:
+  max_attempts_per_pr: 3
+  resume_session_until_attempt: 1
+  mechanical: {paths: [CHANGELOG.md, changelog.d/], verify: tools/changelog-check/check.mjs}
+  agent_tier: tier-large
+"""
+
+
+def contents(text: str):
+    return lambda method, path, body=None: {"content": base64.b64encode(text.encode()).decode()}
+
+
+def failing(exc: Exception):
+    def gh(method, path, body=None):
+        raise exc
+    return gh
+
+
+def test_parse_reads_the_line():
+    c = cc.parse(LINE)
+    assert (c["max_attempts_per_pr"], c["resume_session_until_attempt"], c["agent_tier"]) == (3, 1, "tier-large")
+    assert cc.is_mechanical_path(c, "changelog.d/7.md") and not cc.is_mechanical_path(c, "src/a.rs")
+
+
+@pytest.mark.parametrize("text, field", [
+    ("- a\n", "(root)"),
+    ("conflict: 3\n", "conflict"),
+    ("conflict: {max_attempts_per_pr: 0}\n", "conflict.max_attempts_per_pr"),
+    ("conflict: {max_attempts_per_pr: true}\n", "conflict.max_attempts_per_pr"),
+    ("conflict: {on_limit: retry}\n", "conflict.on_limit"),
+    ("conflict: {mechanical: {paths: [../x]}}\n", "conflict.mechanical.paths"),
+    ("conflict: {mechanical: {verify: /bin/sh}}\n", "conflict.mechanical.verify"),
+])
+def test_parse_raises_the_field_that_is_wrong(text, field):
+    with pytest.raises(cc.ContinuationConfigError) as e:
+        cc.parse(text)
+    assert e.value.field == field and e.value.expected
+
+
+def test_conflict_404_is_the_default_without_a_log():
+    logs = []
+    c = cc.conflict(failing(urllib.error.HTTPError("u", 404, "Not Found", {}, None)), "o/r", log=lambda *a: logs.append(a))
+    assert c == cc.parse("") and logs == []
+
+
+@pytest.mark.parametrize("gh, kind", [
+    (failing(urllib.error.HTTPError("u", 502, "Bad Gateway", {}, None)), "continuation.yaml fetch failed"),
+    (failing(OSError("timed out")), "continuation.yaml fetch failed"),
+    (contents("conflict: {max_attempts_per_pr: 0}\n"), "continuation.yaml invalid"),
+    (contents("conflict: [\n"), "continuation.yaml unreadable"),
+])
+def test_conflict_logs_other_failures_apart_and_falls_back(gh, kind):
+    logs = []
+    assert cc.conflict(gh, "o/r", log=lambda *a: logs.append(a)) == cc.parse("")
+    assert [l[0] for l in logs] == [kind]
+
+
+def test_conflict_reads_the_default_branch():
+    assert cc.conflict(contents(LINE), "o/r")["max_attempts_per_pr"] == 3
