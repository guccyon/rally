diff --git a/orchestrator/dispatcher/continuation_config.py b/orchestrator/dispatcher/continuation_config.py
new file mode 100644
index 0000000..e87c04c
--- /dev/null
+++ b/orchestrator/dispatcher/continuation_config.py
@@ -0,0 +1,140 @@
+"""製品の続きのジョブの線（製品の .factory-config/continuation.yaml の conflict）を読む（ADR 0016・0017 の追記。rally の知見 K-0010・K-0015）。
+
+製品は、既定ブランチとの衝突で積む続きのジョブの線を設定に書く。supervisor は既定ブランチの今の版を GitHub から、ワーカーは取り込んだ
+チェックアウトの版を読む。形はこの 1 か所で決める（ワーカーは python3 continuation_config.py --repo . の JSON を読む）。
+
+- max_attempts_per_pr: 同じ PR の conflict の続きのジョブのうち、エージェントで解いた回の上限。機械的に解いた回（job.finished の
+  agent_tier が none か cost_usd が 0 で succeeded）は数えない。上限に達したら次の衝突では積まず、on_limit（stoppage = 停止 ci:）で人へ回す
+- resume_session_until_attempt: エージェントのセッションを引き継いでよい回（continue.enqueued の attempt）の上限。0 は引き継がない
+- mechanical.paths: 衝突したファイルがすべてこのパス（末尾が / ならその下）に当たるときは、両方の行を残して機械的に解く（git merge-file --union）
+- mechanical.verify: 機械的に解いた結果を確かめる製品の検査（リポジトリの根からのパス。node <verify> --base <既定ブランチ> --head <解いた結果>）。
+  終了コード 0 のときだけ機械的な解消にし、通らなければ（読めなかったときも）エージェントで解く
+- agent_tier: エージェントで解くときの段
+
+ファイルがない・読めない・形が違うときは、今までの Engine の振る舞い（回数で切らない、conflict では引き継がない、CHANGELOG.md だけを検査なしで
+機械的に解く）に戻す。
+"""
+from __future__ import annotations
+
+import base64
+import json
+import sys
+import urllib.error
+from pathlib import Path
+
+import yaml
+
+CONFIG_PATH = ".factory-config/continuation.yaml"
+ON_LIMIT = ("stoppage",)
+DEFAULT_CONFLICT = {"max_attempts_per_pr": None, "on_limit": "stoppage", "resume_session_until_attempt": 0,
+                    "mechanical": {"paths": ["CHANGELOG.md"], "agent_tier": "none", "verify": None}, "agent_tier": None}
+
+
+class ContinuationConfigError(Exception):
+    """設定の形の誤り。field は誤った項目（conflict.max_attempts_per_pr など）、expected は求める形（int>=1 など）。文言は境界（conflict・main）で組む"""
+
+    def __init__(self, field: str, expected: str):
+        super().__init__(field, expected)
+        self.field = field
+        self.expected = expected
+
+
+def _describe(e: Exception) -> str:
+    """ログの 1 行に載せる誤りの中身"""
+    if isinstance(e, ContinuationConfigError):
+        return f"{e.field}: expected {e.expected}"
+    return repr(e)[:200]
+
+
+def _int(v, name: str, low: int) -> int:
+    if isinstance(v, bool) or not isinstance(v, int) or v < low:
+        raise ContinuationConfigError(f"conflict.{name}", f"int>={low}")
+    return v
+
+
+def parse(text: str) -> dict:
+    """設定の文字列から conflict の線を返す。conflict がなければ既定値。形が違えば ContinuationConfigError、YAML として読めなければ yaml.YAMLError"""
+    data = yaml.safe_load(text) or {}
+    if not isinstance(data, dict):
+        raise ContinuationConfigError("(root)", "mapping")
+    c = data.get("conflict")
+    if c is None:
+        return json.loads(json.dumps(DEFAULT_CONFLICT))
+    if not isinstance(c, dict):
+        raise ContinuationConfigError("conflict", "mapping")
+    out = json.loads(json.dumps(DEFAULT_CONFLICT))
+    if c.get("max_attempts_per_pr") is not None:
+        out["max_attempts_per_pr"] = _int(c["max_attempts_per_pr"], "max_attempts_per_pr", 1)
+    if c.get("on_limit") is not None:
+        if c["on_limit"] not in ON_LIMIT:
+            raise ContinuationConfigError("conflict.on_limit", "one of " + "|".join(ON_LIMIT))
+        out["on_limit"] = c["on_limit"]
+    if c.get("resume_session_until_attempt") is not None:
+        out["resume_session_until_attempt"] = _int(c["resume_session_until_attempt"], "resume_session_until_attempt", 0)
+    m = c.get("mechanical")
+    if m is not None:
+        if not isinstance(m, dict):
+            raise ContinuationConfigError("conflict.mechanical", "mapping")
+        paths = m.get("paths", out["mechanical"]["paths"])
+        if not isinstance(paths, list) or not all(isinstance(p, str) and p and not p.startswith("/") and ".." not in p.split("/") for p in paths):
+            raise ContinuationConfigError("conflict.mechanical.paths", "list of relative paths in the repository")
+        verify = m.get("verify")
+        if verify is not None and (not isinstance(verify, str) or not verify or verify.startswith("/") or ".." in verify.split("/")):
+            raise ContinuationConfigError("conflict.mechanical.verify", "relative path in the repository")
+        out["mechanical"] = {"paths": paths, "agent_tier": str(m.get("agent_tier") or "none"), "verify": verify}
+    if c.get("agent_tier") is not None:
+        out["agent_tier"] = str(c["agent_tier"])
+    return out
+
+
+def conflict(gh, repo: str, log=print) -> dict:
+    """製品の既定ブランチの continuation.yaml の conflict の線。ない（404）ときは黙って既定値（今までの振る舞い）。
+    取りに行けない（404 のほかの失敗）・形が違う・YAML として読めないときは、ログに分けて残して既定値にする（衝突の解消は止めない。
+    上限は continue.enqueued の記録で数えるので、次の周期で読めれば線に戻る）"""
+    try:
+        c = gh("GET", f"repos/{repo}/contents/{CONFIG_PATH}")
+    except urllib.error.HTTPError as e:
+        if e.code != 404:
+            log("continuation.yaml fetch failed", repo, f"http {e.code}")
+        return parse("")
+    except Exception as e:  # noqa: BLE001  通信の失敗など。線は読めないが衝突の解消は止めない
+        log("continuation.yaml fetch failed", repo, _describe(e))
+        return parse("")
+    try:
+        return parse(base64.b64decode(c["content"]).decode("utf-8"))
+    except ContinuationConfigError as e:
+        log("continuation.yaml invalid", repo, _describe(e))
+    except (KeyError, TypeError, ValueError, yaml.YAMLError) as e:   # 中身の欠け・base64・UTF-8・YAML の読めなさ
+        log("continuation.yaml unreadable", repo, _describe(e))
+    return parse("")
+
+
+def is_mechanical_path(conf: dict, path: str) -> bool:
+    return any(path.startswith(p) if p.endswith("/") else path == p for p in conf["mechanical"]["paths"])
+
+
+def main(argv: list[str]) -> int:
+    """ワーカーが読む: python3 continuation_config.py --repo <チェックアウト> [--conflicts "<衝突したファイル> ..."]。conflict の線を JSON で出す
+    （読めなければ既定値と標準エラーの 1 行）。--conflicts を渡すと、それがすべて mechanical.paths に当たるか（1 件以上）を mechanical_only に出す"""
+    if len(argv) not in (2, 4) or argv[0] != "--repo" or (len(argv) == 4 and argv[2] != "--conflicts"):
+        print('usage: continuation_config.py --repo <dir> [--conflicts "<file> ..."]', file=sys.stderr)
+        return 2
+    path = Path(argv[1]) / CONFIG_PATH
+    try:
+        out = parse(path.read_text(encoding="utf-8")) if path.is_file() else parse("")
+    except ContinuationConfigError as e:
+        print(f"continuation.yaml invalid: {_describe(e)}", file=sys.stderr)
+        out = parse("")
+    except (OSError, UnicodeDecodeError, yaml.YAMLError) as e:
+        print(f"continuation.yaml unreadable: {_describe(e)}", file=sys.stderr)
+        out = parse("")
+    if len(argv) == 4:
+        files = argv[3].split()
+        out["mechanical_only"] = bool(files) and all(is_mechanical_path(out, f) for f in files)
+    json.dump(out, sys.stdout, ensure_ascii=False)
+    print()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
