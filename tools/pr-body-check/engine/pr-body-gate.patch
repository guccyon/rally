+def act_on_body_gate(cur, repo: str, corr: str, job_id: int, pr_url: str, pr_number: int, gate: dict):
+    """続きのジョブの本文が製品の関所（rally の tools/pr-body-check/gate.mjs）で外れ、ワーカーが本文を書かなかった（rally の知見 K-0001）。
+    外れた（rc 1）なら判定役を待たず検査役にも回さずに body_fix を積む。書かなかった続きのジョブの報告は、工場の記録の下の ### に入れる指摘として渡す。
+    読めない（rc 2）・見出しの定義が不正（rc 3）は本文を直しても通らないので、人に回す"""
+    rc = gate.get("rc")
+    defects = [d for d in ((gate.get("body_fix") or {}).get("defects") or []) if is_body_only(d)]
+    record_event(cur, "pr.body_gate_blocked", corr, job_id, {"pr_url": pr_url, "rc": rc, "defects": len(defects)})
+    if rc == 1 and defects:
+        entry = (gate.get("pending_entry") or "").strip()
+        if entry:
+            defects.append({"rubric_id": defects[0].get("rubric_id"), "severity": "should", "location": "PR 本文 末尾",
+                            "evidence": "続きのジョブの報告を本文に書いていない（関所で外れたため）:\n" + entry[:4000],
+                            "remediation_hint": "この報告の ## 見出しを ### 以下に下げて、「## 工場の記録」の下に入れる"})
+        enqueue_body_fix(cur, repo, corr, pr_url, pr_number, defects)
+        return
+    stoppage.open_stoppage(cur, f"body_gate:{pr_url}", "human", f"PR 本文の関所が終了コード {rc} で本文を書かせなかった",
+                           waiting_for="人による PR 本文と見出しの定義（tools/pr-body-check/template.json）の確認",
+                           correlation_id=corr, job_id=job_id, detected_by="supervisor")
+
+
 def act_on_judgment(cur, repo: str, corr: str, job_id: int, pr_url: str, summary: dict, mode: str):
