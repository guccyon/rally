+  GATE_RC=0
+  GATE_OUT=""
+  if [ -f tools/pr-body-check/gate.mjs ]; then
+    GATE_OUT=$(printf '%s' "${NEW_BODY}" | node tools/pr-body-check/gate.mjs --pr-url "${PR_URL}") || GATE_RC=$?
+  fi
+  if [ "${GATE_RC}" -ne 0 ]; then
+    BODY_FIX_JSON=$(jq -c . <<<"${GATE_OUT}" 2>/dev/null) || BODY_FIX_JSON=null
+    [ -n "${BODY_FIX_JSON}" ] || BODY_FIX_JSON=null
+    # 仕上がった回（未完了の続きが仕上がった）は、報告を足さない本文で仕上げ（未完了の印を外す・Closes に直す・題を戻す・ドラフトを外す）だけを先に行う。
+    # その本文も関所で外れたら書かず、finished.applied を false にして dispatcher に仕上げのやり直しを回させる
+    FINISHED_JSON=null
+    if [ -n "${FINISHED}" ]; then
+      FINISHED_BODY=$(printf '%s' "${OLD_BODY}" | sed -e '/^\*\*未完了\*\*:/d' -e "s/^Refs #${ISSUE_NUMBER}$/Closes #${ISSUE_NUMBER}/")
+      APPLIED=false
+      if printf '%s' "${FINISHED_BODY}" | node tools/pr-body-check/gate.mjs --pr-url "${PR_URL}" >/dev/null 2>&1; then
+        gh pr edit "${CONTINUE_PR}" -R "${REPO}" --title "${TITLE} (#${ISSUE_NUMBER})" --body "${FINISHED_BODY}" >/dev/null
+        gh pr ready "${CONTINUE_PR}" -R "${REPO}" >/dev/null || true
+        APPLIED=true
+      fi
+      FINISHED_JSON=$(jq -nc --argjson applied "${APPLIED}" --arg title "${TITLE} (#${ISSUE_NUMBER})" --arg issue "${ISSUE_NUMBER}" \
+        '{applied:$applied, title:$title, issue_number:($issue|tonumber), remove_incomplete_mark:true, refs_to_closes:true, mark_ready:true}')
+    fi
+    # pending_entry は書かなかった報告の全文（切らない）。handoff は同じ全文を残す引き継ぎのファイル（HANDOFF_DIR がなければ null）
+    BODY_GATE=$(jq -nc --arg rc "${GATE_RC}" --argjson body_fix "${BODY_FIX_JSON}" --arg entry "${ENTRY}" --argjson finished "${FINISHED_JSON}" \
+      --arg handoff "${HANDOFF_DIR:+${HANDOFF_DIR}/jobs/${JOB_ID}/body_gate.json}" \
+      '{rc:($rc|tonumber), body_fix:$body_fix, pending_entry:$entry, finished:$finished, handoff:(if $handoff == "" then null else $handoff end)}')
+    if [ -n "${HANDOFF_DIR}" ]; then
+      mkdir -p "${HANDOFF_DIR}/jobs/${JOB_ID}" && printf '%s\n' "${BODY_GATE}" > "${HANDOFF_DIR}/jobs/${JOB_ID}/body_gate.json" || true
+    fi
+    echo "[worker] pr body gate blocked rc=${GATE_RC} pr=${PR_URL}; body not written${FINISHED:+ (finished applied=${APPLIED})}"
+  elif [ -n "${FINISHED}" ]; then
     gh pr edit "${CONTINUE_PR}" -R "${REPO}" --title "${TITLE} (#${ISSUE_NUMBER})" --body "${NEW_BODY}" >/dev/null
     gh pr ready "${CONTINUE_PR}" -R "${REPO}" >/dev/null || true
   else
