@@ -361,14 +361,36 @@ if [ -n "${CONTINUE_BRANCH}" ]; then
   # 続きのジョブの報告は、本文の末尾に折りたたんで 1 件ずつ足す。見出しのまま足すと、衝突の解消が重なった PR で
   # 同じ見出しが 11 回並び、元の概要が埋もれた（2026-11-02 rally #657）
   ENTRY=$(printf '<details><summary>%s（job %s、turns %s、$%s）</summary>\n\n%s\n\n- model: %s\n</details>' "${SECTION_TITLE}" "${JOB_ID}" "${TURNS}" "${COST}" "${SUMMARY}" "${MODEL}")
-  if grep -q '^## 続きのジョブの記録$' <<<"${OLD_BODY}"; then
+  # 記録の見出しは「## 工場の記録」の下の ### にする（## のまま足すと工場の記録の外に出て、関所で外れる。rally の知見 K-0001）
+  if grep -qE '^##{1,2} 続きのジョブの記録$' <<<"${OLD_BODY}"; then
     NEW_BODY=$(printf '%s\n%s\n' "${OLD_BODY}" "${ENTRY}")
   else
-    NEW_BODY=$(printf '%s\n\n## 続きのジョブの記録\n\n%s\n' "${OLD_BODY}" "${ENTRY}")
+    NEW_BODY=$(printf '%s\n\n### 続きのジョブの記録\n\n%s\n' "${OLD_BODY}" "${ENTRY}")
   fi
+  FINISHED=""
   if [ "${CONTINUE_REASON}" = "incomplete" ] && [ -z "${INCOMPLETE}" ]; then
     # 仕上がったら未完了の印を外し、Issue を閉じる参照に直してドラフトを外す
     NEW_BODY=$(printf '%s' "${NEW_BODY}" | sed -e '/^\*\*未完了\*\*:/d' -e "s/^Refs #${ISSUE_NUMBER}$/Closes #${ISSUE_NUMBER}/")
+    FINISHED=1
+  fi
+  # 書く前に、製品のリポジトリの関所（tools/pr-body-check/gate.mjs）に組んだ本文を照らす（rally の知見 K-0001・議決 D-0019）。
+  # 外れたら（1）本文を書かず、関所の出力（body_fix の入力）を FACTORY_RESULT の body_gate に載せて dispatcher に body_fix を積ませる。
+  # 読めない（2）・見出しの定義が不正（3）ときも書かない（dispatcher が人に回す）。関所のないリポジトリでは今までどおり書く
+  GATE_RC=0
+  GATE_OUT=""
+  if [ -f tools/pr-body-check/gate.mjs ]; then
+    GATE_OUT=$(printf '%s' "${NEW_BODY}" | node tools/pr-body-check/gate.mjs --pr-url "${PR_URL}") || GATE_RC=$?
+  fi
+  if [ "${GATE_RC}" -ne 0 ]; then
+    BODY_FIX_JSON=$(jq -c . <<<"${GATE_OUT}" 2>/dev/null) || BODY_FIX_JSON=null
+    [ -n "${BODY_FIX_JSON}" ] || BODY_FIX_JSON=null
+    BODY_GATE=$(jq -nc --arg rc "${GATE_RC}" --argjson body_fix "${BODY_FIX_JSON}" --arg entry "${ENTRY}" \
+      '{rc:($rc|tonumber), body_fix:$body_fix, pending_entry:$entry}')
+    if [ -n "${HANDOFF_DIR}" ]; then
+      mkdir -p "${HANDOFF_DIR}/jobs/${JOB_ID}" && printf '%s\n' "${BODY_GATE}" > "${HANDOFF_DIR}/jobs/${JOB_ID}/body_gate.json" || true
+    fi
+    echo "[worker] pr body gate blocked rc=${GATE_RC} pr=${PR_URL}; body not written"
+  elif [ -n "${FINISHED}" ]; then
     gh pr edit "${CONTINUE_PR}" -R "${REPO}" --title "${TITLE} (#${ISSUE_NUMBER})" --body "${NEW_BODY}" >/dev/null
     gh pr ready "${CONTINUE_PR}" -R "${REPO}" >/dev/null || true
   else
