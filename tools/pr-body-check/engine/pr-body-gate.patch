+def act_on_body_gate(cur, repo: str, corr: str, job_id: int, pr_url: str, pr_number: int, gate: dict):
+    """続きのジョブの本文が製品の関所（rally の tools/pr-body-check/gate.mjs）で外れ、ワーカーが本文を書かなかった（rally の知見 K-0001）。
+    外れた（rc 1）なら判定役を待たず検査役にも回さずに body_fix を積む。書かなかった続きのジョブの報告は、工場の記録の下の ### に入れる指摘として渡す。
+    読めない（rc 2）・見出しの定義が不正（rc 3）は本文を直しても通らないので、人に回す。
+    未完了の続きが仕上がった回で、ワーカーが仕上げ（未完了の印を外す・Closes・題・ドラフトを外す）を書けなかった（finished.applied が false）ときも人に回す"""
+    rc = gate.get("rc")
+    defects = [d for d in ((gate.get("body_fix") or {}).get("defects") or []) if is_body_only(d)]
+    finished = gate.get("finished") if isinstance(gate.get("finished"), dict) else None
+    pending_finish = bool(finished and not finished.get("applied"))   # 仕上がった回の仕上げ（未完了の印・Closes・題・ドラフト）をワーカーが書けなかった
+    record_event(cur, "pr.body_gate_blocked", corr, job_id, {"pr_url": pr_url, "rc": rc, "defects": len(defects),
+                                                            "finished": (finished or {}).get("applied") if finished else None})
+    if pending_finish:
+        # 仕上げは本文の行を消す・題を戻す・ドラフトを外すことで、末尾に足すだけの body_fix ではできないので、人に回す
+        n = finished.get("issue_number")
+        stoppage.open_stoppage(cur, f"body_gate_finish:{pr_url}", "human", "仕上がった続きのジョブの本文が関所で外れ、PR の仕上げをしていない",
+                               waiting_for=f"人による PR の仕上げ（本文の「**未完了**:」の行を消し、「Refs #{n}」を「Closes #{n}」に直し、"
+                                           f"題を「{finished.get('title')}」に戻し、ドラフトを外す）",
+                               correlation_id=corr, job_id=job_id, detected_by="supervisor")
+    if rc == 1 and defects:
+        entry = (gate.get("pending_entry") or "").strip()
+        if entry:
+            # 報告は切らずに全文を渡す（body_fix はこの evidence から本文を組み直すので、切ると切った分が本文に戻らない）。
+            # 引き継ぎに残した全文の場所も添える
+            handoff = gate.get("handoff")
+            defects.append({"rubric_id": defects[0].get("rubric_id"), "severity": "should", "location": "PR 本文 末尾",
+                            "evidence": "続きのジョブの報告を本文に書いていない（関所で外れたため）:\n" + entry
+                                        + (f"\n\n（同じ全文を引き継ぎの {handoff} の pending_entry に残した）" if handoff else ""),
+                            "remediation_hint": "この報告の全文を、## 見出しを ### 以下に下げて「## 工場の記録」の下に入れる"})
+        enqueue_body_fix(cur, repo, corr, pr_url, pr_number, defects)
+        return
+    stoppage.open_stoppage(cur, f"body_gate:{pr_url}", "human", f"PR 本文の関所が終了コード {rc} で本文を書かせなかった",
+                           waiting_for="人による PR 本文と見出しの定義（tools/pr-body-check/template.json）の確認",
+                           correlation_id=corr, job_id=job_id, detected_by="supervisor")
+
+
 def act_on_judgment(cur, repo: str, corr: str, job_id: int, pr_url: str, summary: dict, mode: str):
     pr_number = int(pr_url.rsplit("/", 1)[1])
