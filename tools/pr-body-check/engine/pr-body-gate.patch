+  --arg incomplete "${INCOMPLETE}" --arg rc "${CLAUDE_RC}" --argjson body_gate "${BODY_GATE:-null}" \
+  '{pr_url:$pr, pr_number:($n|tonumber), usage:$usage, cost_usd:($cost|tonumber), model:$model, num_turns:($turns|tonumber), change_types:[$ct], files:$files, lessons:$lessons, provisional_raw:$provisional, knowledge_ids:$knowledge, incomplete:($incomplete=="1"), claude_exit:($rc|tonumber), body_gate:$body_gate}')"
